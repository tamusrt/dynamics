-------------------------------
//Simulation Setup
sim
{
    name = "telemachus_hearne";

    // Time step
    timeStep = 0.01;

    // Simulation time
   timeFlight = 48;

    // Number of Monte Carlo flights
   numMC = 150;
    randRepeat = 1;

    // Random seed control
    randSeed = 12;
    NumThreads = 13;
}
-------------------------------
//Flight Variables
//Available values:
//time,alt,vel,accel,mach,Cd,drag,
//temp,grav,press,rho,spSd,thrust,mass
flt
{
    thrust
    {
        dist = "Half Wiener";
        mean = 0;
        stdDev = 0.025;
    }
    temp
    {
        dist = "Wiener";
        mean = 0;
        stdDev = 0.0125;
    }
    press
    {
        dist = "Wiener";
        mean = 0;
        stdDev = 0.0125;
    }
    rho
    {
        dist = "Wiener";
        mean = 0;
        stdDev = 0.0125;
    }
}
-------------------------------
//Atmospheric Properties
atm
{
    // Atmosphere modeled up to maxAlt [ft]
    maxAlt = 30000;

    // [ft]
    elev = 285.0;
    lat = 30.8725;

    // Ambient temperature [deg F]
    tempAmb
    {
        dist = "LHS";
        upper = 2.0;
       lower = 1.0;
    }

    // Ambient pressure (not sea level) [psi]
    pressAmb
    {
        dist = "LHS";
           upper = 2.0;
           lower = 2.0;
    }

    // Ambient humidity [-], 0 <= hum <= 1
    relHum
    {
        dist = "LHS";
        upper = 2.0;
        lower = 2.0;
    }

    // Average wind velocity [ft/s]
    windAvg
    {
        dist = "Normal";
        mean = 2.0;
        stdDev = 2.0;
    }

    // Turbulent intensity, values ~(0-4) [-]
    turbInt = 2;

    // Incoming wind direction measured CCW from east [deg]
    windHead
    {
        dist = "Normal";
        mean = 2.0;
        stdDev = 2.0;
    }
}
-------------------------------
//Body (Vehicle) Properties
bod
{
    // [-]
    numFin = 4;

    // [ft^2] reference (cross-sectional) area
    refArea =  28.274333882308138/ 144;

    // [ft^2]
    finArea =  2.0 / 144;
    
    // measured mass on scales [lb_m]
    massDry = 2.0;

    // [ft]
    length = 2.0 / 12;
   ixxDry = 2.0;

    // [lb_f * ft * s^2]
    iyyDry = 2.0;

    // [lb_f * ft * s^2]
    izzDry = 2.0;
    posCG =  76.47/ 12;

    // Centroid of fuel grain measured from nose [ft]
    posFuel =  2.0/ 12;

    // Centroid of fins measured from nose [ft]
    posFin = 2.0 / 12;

    // Launch rail length [ft]
    railLength = 2.0;

    // Launch rail elevation from horizontal [deg]
    railElev
    {
        dist = "Normal";
        mean = 90;
        stdDev = 0.5;
    }

    // Launch rail heading measured CCW from east [deg]
    railHead
    {
        dist = "Normal";
        mean = 90;
        stdDev = 1;
    }

    // Aluminum to Aluminum (dry) dynamic coefficient of friction [-]
    railFrict = 0.5;

    // Filepath to aerodynamic dataset
    aeroModel = "./input/aero/telemachus_hearne_feb2024.dat";
}
-------------------------------
//Propulsion Properties
prp
{
    // Solid or hybrid?
    type = "solid";
    
    // HEM filepath
    engModel = "input/prp/L_M3464/L_M3464.mat";
    timeStep = 0.01;
    engine = "L_M3464";

    // |logical|
   additives = false;
    interp = "makima";
    extrap = "makima";



    // Thrust efficiency, multiplicative factor [-]
    thrustEta = 1;

    // Engine startup time [s]
    startup
    {
        dist = "LHS";
        lower = .1;
        upper = .1;
    }
    forceOptimExp = true;
    runVentCalc = false;
}

imp
{
    // Simulate recovery?
    runRecov = true;
    timeStep = 0.01;
   timeRecov = 300;

    // Main deployment altitude
    mainAlt = 1000;
    {
        dist = "Uniform";
        lower = 900;
        upper = 1100;
    }

    // Coefficient of drag, drogue
    cdsDrogue = 2.0;

    // Coefficient of drag, main
    cdsMain = 2.0;

    // Coefficient of drag, vehicle (lateral,free stream perpendiular to rocket) = 1.1 (thin disk) * pi * length^2 / 4 / 144
    cdsLat = 1.1 * (2.0 / 12) * (0 / 12);
    // Coefficient of drag, vehicle (longitudinal,free stream parallel to rocket)
    cdsLong = 0.82 * ((0) * pi / 4 / 144);
}

