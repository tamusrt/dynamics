DIM IN

 $REFQ XCG=129.0,SREF=28.27, ROUGH=0.00025,LREF=6.00$
 $AXIBOD LNOSE=30.00,DNOSE=6.00,TNOSE=KARMAN,
         LAFT=176.39,DAFT=6.00,$
        
 $FINSET1 XLE=178.39,SWEEP=60.1,SECTYP=HEX,
